{
  "name": "dsh-sessions-manager",
  "description": "DSH 会话管理插件：设置面板 + 侧栏双入口，归档 / 恢复 / 跨工作区移动 / 回收站（可恢复、批量清空、自动清理），子代理折叠与血缘、删父会话连带子代理，空白会话识别，按标题 · ID · 工作区搜索，带磁盘占用与会话详情。已适配 DSH 0.1.7 / 0.2.0 / 0.2.1 / 0.2.2-rc.3。Session manager for DeepSeek Harness — archive / restore / move / trash lifecycle from both the settings panel and the sidebar, with subagent lineage, blank detection and per-session stats (0.1.7 / 0.2.0 / 0.2.1 / 0.2.2-rc.3 ready).",
  "version": "3.7.13",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "session-manager",
    "archived-sessions",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TOBYCAI/dsh-sessions-manager.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "check:dist": "npm run build && git diff --exit-code -- lib",
    "check:sessions": "node scripts/check-session-health.mjs",
    "prepack": "node build.mjs",
    "check:runtime": "node scripts/compat-runtime.mjs ${DSH_RUNTIME:-$HOME/.dsh/runtime}"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}
